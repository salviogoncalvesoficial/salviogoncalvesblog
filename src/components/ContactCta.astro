---
const { compact = false, margin = false, docked = false, side = false } = Astro.props;
---
{compact ? (
  <a class:list={["contact-strip", docked && "docked"]} href="/contato/agendamento/" aria-label="Seu próximo passo — abrir agendamento">
    <span>Seu próximo passo</span><strong>Vamos conversar</strong>
  </a>
) : (
  <section class:list={["contact-cta-card", margin && "contact-margin-card", side && "contact-side-card"]} data-contact-hero aria-labelledby={margin ? "contact-margin-title" : "contact-cta-title"}>
    <p class="contact-cta-kicker">Um convite para você</p>
    <h2 id={margin ? "contact-margin-title" : "contact-cta-title"}>Seu próximo passo começa aqui</h2>
    <p>Se algo dentro de você pede mudança, podemos conversar sobre isso com calma e acolhimento.</p>
    <a href="/contato/agendamento/">Escolher um horário</a>
  </section>
)}
<style>
.contact-cta-card{border:1px solid rgb(var(--color-line));border-radius:1.5rem;background:rgb(var(--color-card)/.92);padding:1.5rem;box-shadow:0 12px 30px rgb(var(--color-base)/.06)}.contact-cta-kicker{margin:0 0 .6rem;color:rgb(var(--color-accent));font-size:.72rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase}.contact-cta-card h2{margin:0;color:rgb(var(--color-accent));font-size:1.45rem;line-height:1.2}.contact-cta-card p:not(.contact-cta-kicker){margin:.8rem 0 1.2rem;line-height:1.6;color:rgb(var(--color-base)/.8)}.contact-cta-card a{display:inline-flex;align-items:center;gap:.45rem;border-radius:999px;background:rgb(var(--color-accent));padding:.7rem 1rem;color:rgb(var(--color-inverted));font-size:.85rem;font-weight:600;transition:opacity .2s ease}.contact-cta-card a:hover{opacity:.88}.contact-margin-card{position:sticky;top:1.25rem}.contact-side-card{display:none}@media(min-width:1536px){.contact-margin-card h2{font-size:1.2rem}.contact-margin-card p:not(.contact-cta-kicker){font-size:.86rem;margin:.6rem 0 1rem}.contact-margin-card a{padding:.6rem .85rem;font-size:.78rem}.contact-side-card{display:block;position:fixed;top:7.75rem;left:calc(50% + 33rem);width:clamp(250px,calc(50vw - 34rem),320px);z-index:30}}.contact-strip{position:fixed;top:.6rem;left:50%;z-index:35;display:flex;width:min(50rem,calc(100% - 1rem));transform:translate(-50%,-200%);align-items:center;justify-content:space-between;gap:1rem;border:1px solid rgb(var(--color-line));border-radius:999px;background:rgb(var(--color-card)/.96);padding:.6rem .75rem .6rem 1.1rem;box-shadow:0 8px 24px rgb(var(--color-base)/.16);backdrop-filter:blur(12px);color:rgb(var(--color-base));transition:transform .3s ease}.contact-strip.is-visible{transform:translate(-50%,0)}.contact-strip strong{border-radius:999px;background:rgb(var(--color-accent));padding:.5rem .8rem;color:rgb(var(--color-inverted));font-size:.78rem;white-space:nowrap}.contact-strip.docked{position:sticky;top:var(--contact-dock-top,.5rem);transform:none;transition:none;margin:.5rem auto 0;width:min(50rem,calc(100% - 2rem))}@media(min-width:1536px){.contact-strip{display:none!important}}@media(prefers-reduced-motion:reduce){.contact-strip{transition:none}}
</style>
<script is:inline>
(function(){function dockStrip(){var strip=document.querySelector(".contact-strip.docked");if(!strip)return;var header=document.querySelector(".header-sticky");if(header)strip.style.setProperty("--contact-dock-top",(header.getBoundingClientRect().height+8)+"px")}function sideSticky(){var card=document.querySelector(".contact-side-card");if(!card){if(window.__sideCleanup){window.__sideCleanup();window.__sideCleanup=null}return}if(window.__sideCleanup){window.__sideCleanup();window.__sideCleanup=null}var base=parseFloat(getComputedStyle(card).top)||124;var header=document.querySelector(".header-sticky");var floor=header?header.getBoundingClientRect().height+8:20;function upd(){card.style.top=Math.max(floor,base-(window.scrollY||0))+"px"}upd();window.addEventListener("scroll",upd,{passive:true});window.addEventListener("resize",upd);window.__sideCleanup=function(){window.removeEventListener("scroll",upd);window.removeEventListener("resize",upd)}}dockStrip();sideSticky();window.addEventListener("resize",dockStrip);document.addEventListener("astro:after-swap",function(){dockStrip();sideSticky()})})();
</script>