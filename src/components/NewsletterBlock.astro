---
const formEmbedHtml = `
<form class="nl-form" id="nl-form" novalidate>
  <input type="text" name="website" class="nl-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="email" name="email" required placeholder="Seu melhor e-mail" class="nl-input" autocapitalize="off" autocorrect="off" spellcheck="false" />
  <button type="submit" class="nl-btn">Inscrever</button>
</form>
<div class="nl-success display-none" id="nl-success"><p class="nl-success-title">Inscrição confirmada! 🎉</p><p class="nl-success-text">A partir de agora, os novos artigos chegam direto no seu e-mail. Confira sua caixa de entrada — acolhimento em breve!</p></div>
<div class="nl-pending display-none" id="nl-pending"><p class="nl-success-title">Confira seu e-mail 📩</p><p class="nl-success-text">Enviamos um link de confirmação. Clique nele para concluir sua inscrição — ele é válido por 48 horas.</p></div>
<div class="nl-already display-none" id="nl-already"><p class="nl-success-title">Este e-mail já está inscrito ✅</p><p class="nl-success-text">Você continuará recebendo os próximos artigos por e-mail.</p></div>
<p class="nl-error display-none" id="nl-error"><span id="nl-error-msg">Ops — este e-mail não parece válido. Tente novamente, por favor.</span></p>
<p class="nl-privacy" id="nl-privacy">Sem spam. Você pode cancelar com 1 clique, a qualquer momento.</p>
<p class="nl-age">Newsletter destinada exclusivamente a maiores de 18 anos.</p>
`;
---
{
  formEmbedHtml && (
    <section class="newsletter" aria-label="Assine a newsletter" id="newsletter">
      <div class="newsletter-card">
        <p class="newsletter-eyebrow">Newsletter</p><h2>Receba os novos artigos em primeira mão</h2>
        <p class="newsletter-text">Toda vez que eu publicar um texto novo, você recebe direto no seu e-mail. Sem spam — só reflexões para uma vida mais leve e consciente.</p>
        <div class="newsletter-form" set:html={formEmbedHtml} />
      </div>
    </section>
  )
}
<style>
.newsletter{@apply mx-auto w-full max-w-5xl px-4 pb-4 pt-12}.newsletter-card{@apply rounded-2xl border border-skin-line bg-skin-card p-8 text-center sm:p-10}.newsletter-eyebrow{@apply mb-2 text-xs font-medium uppercase tracking-[0.2em] text-skin-accent}.newsletter-card h2{@apply text-xl font-semibold sm:text-2xl}.newsletter-text{@apply mx-auto mt-3 max-w-md text-sm leading-relaxed opacity-80}.newsletter-form{@apply mt-6}.newsletter-form :global(.nl-form){@apply mx-auto flex max-w-md flex-col gap-3 sm:flex-row}.newsletter-form :global(.nl-input){@apply w-full flex-1 rounded-full border border-skin-line bg-skin-fill px-5 py-3 text-sm text-skin-base outline-none focus:border-skin-accent}.newsletter-form :global(.nl-btn){@apply rounded-full bg-skin-accent px-6 py-3 text-sm font-medium text-skin-inverted transition-opacity hover:opacity-90}.newsletter-form :global(.nl-btn:disabled){@apply opacity-60}.newsletter-form :global(.nl-honeypot){@apply hidden}.newsletter-form :global(.nl-privacy),.newsletter-form :global(.nl-age){@apply mt-3 text-xs opacity-60}.newsletter-form :global(.nl-age){@apply mt-1}.newsletter-form :global(.nl-success),.newsletter-form :global(.nl-pending),.newsletter-form :global(.nl-already){@apply mx-auto mt-6 max-w-md rounded-xl border border-skin-accent bg-skin-fill p-4}.newsletter-form :global(.nl-success-title){@apply m-0 font-semibold text-skin-accent}.newsletter-form :global(.nl-success-text){@apply m-0 mt-1 text-sm opacity-80}.newsletter-form :global(.nl-error){@apply mx-auto mt-6 max-w-md rounded-xl border border-red-400 bg-skin-fill p-4 text-sm text-red-600}
</style>
<script>
function bindNewsletter(){const form=document.getElementById("nl-form");const section=document.getElementById("newsletter");if(!form||form.dataset.bound)return;form.dataset.bound="1";const localKey="newsletter_confirmed_v1";if(localStorage.getItem(localKey)==="1"){section?.classList.add("display-none");return}form.addEventListener("submit",async e=>{e.preventDefault();const input=form.querySelector(".nl-input"),btn=form.querySelector(".nl-btn"),success=document.getElementById("nl-success"),pending=document.getElementById("nl-pending"),already=document.getElementById("nl-already"),error=document.getElementById("nl-error"),errorMsg=document.getElementById("nl-error-msg"),privacy=document.getElementById("nl-privacy");if(!input||!btn)return;btn.disabled=true;btn.textContent="Enviando...";try{const res=await fetch("/.netlify/functions/inscrever",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded",Accept:"application/json"},body:`email=${encodeURIComponent(input.value)}`}),data=await res.json();form.classList.add("display-none");privacy?.classList.add("display-none");if(data.status==="pending")pending?.classList.remove("display-none");else if(data.status==="already"){already?.classList.remove("display-none");localStorage.setItem(localKey,"1")}else if(data.status==="ok"){success?.classList.remove("display-none");localStorage.setItem(localKey,"1")}else{form.classList.remove("display-none");error?.classList.remove("display-none");if(errorMsg)errorMsg.textContent=data.status==="erro_envio"?"Não foi possível enviar o e-mail de confirmação agora. Tente novamente em instantes.":"Ops — este e-mail não parece válido. Tente novamente, por favor."}}catch{form.classList.remove("display-none");error?.classList.remove("display-none");if(errorMsg)errorMsg.textContent="Não consegui enviar agora. Verifique sua conexão e tente de novo."}finally{btn.disabled=false;btn.textContent="Inscrever"}})}bindNewsletter();document.addEventListener("astro:after-swap",bindNewsletter)
</script>