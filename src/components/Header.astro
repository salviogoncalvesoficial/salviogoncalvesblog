---
import { LOGO_IMAGE, SITE } from "@config";
import Hr from "./Hr.astro";
import LinkButton from "./LinkButton.astro";
export interface Props { activeNav?: "home" | "posts" | "tags" | "about" | "search" | "ethical"; sticky?: boolean; }
const { activeNav, sticky = false } = Astro.props;
---
<header class:list={{ "header-sticky": sticky }}><a id="skip-to-content" href="#main-content">Pular para o conteúdo</a><div class="header-inner"><div class="top-row"><button class="hamburger-menu focus-outline" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-items"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon"><line x1="7" y1="12" x2="21" y2="12" class="line"></line><line x1="3" y1="6" x2="21" y2="6" class="line"></line><line x1="12" y1="18" x2="21" y2="18" class="line"></line><line x1="18" y1="6" x2="6" y2="18" class="close"></line><line x1="6" y1="6" x2="18" y2="18" class="close"></line></svg></button><a href="/" class="logo whitespace-nowrap" aria-label={SITE.title}><img src="/1789058904492-logo.png" alt="Salvio Gonçalves — Terapeuta" width={LOGO_IMAGE.width} height={LOGO_IMAGE.height} /></a><div class="top-actions"><LinkButton href="/search/" className={`focus-outline p-2 sm:p-1 ${activeNav === "search" ? "active" : ""} flex`} ariaLabel="Buscar" title="Buscar"><svg xmlns="http://www.w3.org/2000/svg" class="scale-110 sm:scale-100"><path d="M19.023 16.977a35.13 35.13 0 0 1-1.367-1.384c-.372-.378-.596-.653-.596-.653l-2.8-1.337A6.962 6.962 0 0 0 16 9c0-3.859-3.14-7-7-7S2 5.141 2 9s3.14 7 7 7c1.763 0 3.37-.66 4.603-1.739l1.337 2.8s.275.224.653.596c.387.363.896.854 1.384 1.367l1.358 1.392.604.646 2.121-2.121-.646-.604c-.379-.372-.885-.866-1.391-1.36zM9 14c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5z"></path></svg><span class="sr-only">Buscar</span></LinkButton>{SITE.lightAndDarkMode && <button id="theme-btn" class="focus-outline" title="Alternar tema claro e escuro" aria-label="auto" aria-live="polite"><svg id="moon-svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg><svg id="sun-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l-1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>}</div></div><nav id="nav-menu" aria-label="Navegação principal"><ul id="menu-items" class="display-none sm:flex"><li><a href="/" class={activeNav === "home" ? "active" : ""}>Início</a></li><li><a href="/posts/" class={activeNav === "posts" ? "active" : ""}>Artigos</a></li><li><a href="/tags/" class={activeNav === "tags" ? "active" : ""}>Temas</a></li><li><a href="/about/" class={activeNav === "about" ? "active" : ""}>Sobre</a></li><li><a href="/compromisso-etico/" class={activeNav === "ethical" ? "active" : ""}>Compromisso ético</a></li></ul></nav></div><Hr /></header>
<style>
.header-sticky{@apply sticky top-0 z-40 bg-skin-fill}#skip-to-content{@apply absolute -top-full left-16 z-50 bg-skin-accent px-3 py-2 text-skin-inverted transition-all focus:top-4}.header-inner{@apply relative mx-auto w-full max-w-5xl px-4}.top-row{@apply relative flex items-center justify-between gap-1 py-3 sm:gap-4 sm:py-6}.hamburger-menu{@apply z-20 p-2 sm:hidden}.hamburger-menu svg{@apply h-6 w-6 scale-125 fill-skin-base}.logo{@apply absolute left-1/2 top-1/2 z-10 w-[78%] -translate-x-1/2 -translate-y-1/2 truncate text-center text-base font-semibold sm:w-auto sm:max-w-[60%] sm:text-2xl}.logo img{display:block;width:min(300px,100%);height:auto;max-height:72px;object-fit:contain}.top-actions{@apply z-20 ml-auto flex items-center gap-0 sm:gap-2}.top-actions a,.top-actions button{@apply flex items-center}.top-actions svg{@apply h-6 w-6 fill-skin-base hover:fill-skin-accent}#theme-btn{@apply p-2 sm:p-1}#theme-btn svg{@apply scale-110 hover:rotate-12 sm:scale-100}#theme-btn svg#sun-svg{fill:none;stroke:currentColor}#nav-menu{@apply w-full}#menu-items{@apply absolute left-0 right-0 top-full z-40 mt-1 rounded-xl bg-skin-card p-3 shadow-lg sm:static sm:mt-0 sm:flex sm:items-center sm:justify-center sm:gap-x-6 sm:rounded-none sm:bg-transparent sm:p-0 sm:shadow-none sm:pb-4}#menu-items li a{@apply block w-full px-4 py-3 text-center font-medium hover:text-skin-accent sm:w-auto sm:px-2 sm:py-1}#menu-items a.active{@apply underline decoration-wavy decoration-2 underline-offset-4}.menu-icon line{@apply transition-opacity duration-75 ease-in-out}.menu-icon .close{opacity:0}.menu-icon.is-active .line{@apply opacity-0}.menu-icon.is-active .close{@apply opacity-100}@media(max-width:680px){.logo{width:78%}.logo img{max-height:58px}}
</style>
<script>function toggleNav(){const menuBtn=document.querySelector(".hamburger-menu");const menuIcon=document.querySelector(".menu-icon");const menuItems=document.querySelector("#menu-items");menuBtn?.addEventListener("click",()=>{const menuExpanded=menuBtn.getAttribute("aria-expanded")==="true";menuIcon?.classList.toggle("is-active");menuBtn.setAttribute("aria-expanded",menuExpanded?"false":"true");menuBtn.setAttribute("aria-label",menuExpanded?"Abrir menu":"Fechar menu");menuItems?.classList.toggle("display-none")})}toggleNav();document.addEventListener("astro:after-swap",toggleNav);</script>