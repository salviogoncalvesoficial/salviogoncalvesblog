.cover-box{margin-top:16px}.cover-label{font-size:12px;color:var(--m);margin-bottom:7px;display:block}.cover-drop{position:relative;border:2px dashed var(--l);border-radius:14px;background:var(--s);cursor:pointer;transition:border-color .15s ease,background .15s ease;overflow:hidden}.cover-drop:hover{border-color:var(--g)}.cover-drop.has{border-style:solid;border-color:var(--l);background:var(--box)}.cover-drop input{display:none}.cover-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:26px 14px;color:var(--m);font-size:13.5px;text-align:center}.cover-empty .plus{font-size:22px;color:var(--g);line-height:1}.cover-preview{position:relative;display:none}.cover-preview img{width:100%;aspect-ratio:770/330;object-fit:cover;display:block}.cover-drop.has .cover-preview{display:block}.cover-drop.has .cover-empty{display:none}.cover-tools{position:absolute;top:8px;right:8px;display:flex;gap:6px;opacity:0;transition:opacity .15s ease}.cover-drop.has:hover .cover-tools{opacity:1}.cover-tools button{background:rgba(255,255,255,.94);border:0;border-radius:99px;padding:7px 13px;font-size:12.5px;font-weight:600;color:var(--g);cursor:pointer;box-shadow:0 2px 10px rgba(44,39,35,.18)}.cover-tools button.del{color:var(--terra)}.cover-hint{font-size:11px;color:var(--m);margin-top:5px}.cover-up{position:absolute;inset:0;display:grid;place-items:center;background:rgba(250,247,242,.82);backdrop-filter:blur(2px);font-size:13.5px;font-weight:600;color:var(--g)}
@media(max-width:680px){
body{padding:12px 8px}.card{padding:16px;border-radius:14px}
.tabs{gap:6px}.tab{flex:1;padding:10px 6px;font-size:12.5px;text-align:center}.badge{margin-left:2px}
#refresh,.desk-search #refresh{display:none!important}.list-head{flex-wrap:nowrap;align-items:flex-start}.list-head>div:first-child{flex:1;min-width:0}h1{font-size:20px}.list-head .sub{display:none}.desk-search{margin-top:-4px}.menu-btn,.search-btn{display:inline-flex;width:40px;height:40px;padding:0;align-items:center;justify-content:center;flex:0 0 40px}
#list-card{position:relative}.email-list{margin-top:10px}.desk-search{display:flex;flex:0 0 auto;justify-content:flex-end}.desk-search #search{display:none}.desk-search .menu-btn{width:40px;height:40px;flex:0 0 40px}#desk-filters{display:none!important}
#toolbar{display:block}.toolbar{gap:7px}
/* busca vira caixa flutuante */
#search,#search-m{display:none;position:absolute;left:8px;right:8px;top:70px;z-index:40;padding:13px 16px;border-radius:14px;box-shadow:0 10px 30px rgba(44,39,35,.18);min-width:0}
#toolbar.search-open #search-m{display:block}
/* filtros viram menu flutuante vertical, alinhado à direita */
#filters{display:none;position:absolute;right:8px;top:70px;z-index:40;flex-direction:column;gap:7px;min-width:180px;flex-wrap:nowrap}
#toolbar.filters-open #filters{display:flex}
.filter{padding:12px 16px;font-size:13.5px;text-align:center;white-space:nowrap}
.stats{grid-template-columns:repeat(2,1fr)}.row input{width:100%}
.actions{gap:7px}.actions button{flex:1 1 45%;padding:11px 6px;font-size:13px;text-align:center}.r-actions .icon-btn{flex:0 0 auto;padding:11px}.r-actions .spacer{width:44px}
.reader-body{padding:16px;font-size:14.5px}.reader-top{gap:4px;margin-top:-7px}#close{padding:8px 14px;font-size:13px;line-height:1}.fab{right:16px;bottom:18px;width:54px;height:54px}
.email-card{padding:13px 14px}.ec-top .from{font-size:12px}.ec-subject{font-size:15px}.ec-mid .date{font-size:11px}
.ggrid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}.gitem .thumb{height:80px}.pop{position:fixed;left:12px;right:12px;max-width:none}
