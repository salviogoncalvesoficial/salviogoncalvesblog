---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
---
<Layout title={`Contato | ${SITE.title}`} description="Entre em contato para conversar e combinar um horário."><Header /><main id="contact-page"><section class="contact-intro"><p class="eyebrow">Um espaço para você</p><h1>Talvez este seja o momento de olhar para você com mais cuidado.</h1><p class="lead">Vamos conversar sobre o que você está vivendo e encontrar, com calma, um próximo passo possível.</p><p class="details">O contato é feito pelo WhatsApp.</p></section><section class="booking-card" aria-labelledby="booking-title"><h2 id="booking-title">Vamos conversar</h2><p>Envie uma mensagem para combinarmos um horário.</p><div class="booking-notice" role="note"><strong>Você será direcionado ao WhatsApp</strong><span>Este canal serve para contato e combinação de horário. Não envie diagnósticos, históricos clínicos, informações sobre medicamentos ou outros dados de saúde por esse canal.</span><span>O WhatsApp é uma plataforma externa, sujeita aos próprios termos e à política de privacidade da Meta. O contato é destinado exclusivamente a maiores de 18 anos.</span></div><a class="booking-link" href="https://wa.me/352691536734" target="_blank" rel="noopener noreferrer">Falar pelo WhatsApp <span aria-hidden="true">↗</span></a></section></main><Footer /></Layout>
<style>#contact-page{max-width:54rem;margin:0 auto;padding:4rem 1rem 5rem}.contact-intro{max-width:42rem;margin:0 auto 2.5rem;text-align:center}.eyebrow{display:inline-block;margin:0 0 1rem;border:1px solid rgb(var(--color-line));border-radius:999px;padding:.35rem .8rem;color:rgb(var(--color-accent));font-size:.75rem;text-transform:uppercase;letter-spacing:.16em}h1{margin:0;color:rgb(var(--color-accent));font-size:clamp(2rem,5vw,3.2rem);line-height:1.12}.lead{margin:1.4rem auto 0;max-width:38rem;font-size:1.15rem;line-height:1.75}.details{margin:1rem auto 0;max-width:36rem;color:rgb(var(--color-base)/.75);font-size:.95rem}.booking-card{margin:0 auto;border:1px solid rgb(var(--color-line));border-radius:1.5rem;background:rgb(var(--color-card));padding:clamp(1.25rem,4vw,2rem);box-shadow:0 12px 35px rgb(var(--color-base)/.06)}.booking-card h2{margin:0;color:rgb(var(--color-accent));font-size:1.4rem}.booking-card>p{margin:.45rem 0 1rem;color:rgb(var(--color-base)/.75)}.booking-notice{display:grid;gap:.4rem;margin:1.25rem 0;padding:1rem 1.1rem;border-left:3px solid rgb(var(--color-accent));border-radius:.75rem;background:rgb(var(--color-fill)/.7);line-height:1.55}.booking-notice strong{color:rgb(var(--color-accent));font-size:.95rem}.booking-notice span{color:rgb(var(--color-base)/.78);font-size:.9rem}.booking-link{display:inline-flex;align-items:center;gap:.45rem;margin-top:.25rem;border-radius:999px;background:rgb(var(--color-accent));padding:.75rem 1rem;color:rgb(var(--color-inverted));font-weight:600;text-decoration:none}.booking-link:hover{opacity:.88}@media(max-width:640px){#contact-page{padding:2.5rem .75rem 4rem}.contact-intro{text-align:left;margin-bottom:2rem}.lead{font-size:1.05rem}.booking-link{width:100%;justify-content:center}}</style>
