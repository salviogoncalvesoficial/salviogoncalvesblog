---
import { LOCALE, SITE } from "@config";
import "@styles/base.css";
import { ViewTransitions } from "astro:transitions";
import ContactCta from "@components/ContactCta.astro";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
export interface Props { title?: string; author?: string; description?: string; ogImage?: string; canonicalURL?: string; pubDatetime?: Date; modDatetime?: Date | null; scrollSmooth?: boolean; }
const { title = SITE.title, author = SITE.author, description = SITE.desc, ogImage = SITE.ogImage, canonicalURL = new URL(Astro.url.pathname, Astro.site).href, pubDatetime, modDatetime, scrollSmooth = false } = Astro.props;
const socialImageURL = new URL(ogImage ?? SITE.ogImage ?? "og.png", Astro.url.origin).href;
const path = Astro.url.pathname;
const isContactPage = path.startsWith("/contato");
const isSearchPage = path.startsWith("/search");
const isAboutPage = path.startsWith("/about");
const isHome = path === "/";
const isTagsPage = path.startsWith("/tags");
const isPostsPage = path === "/posts/" || /^\/posts\/\d+\/$/.test(path);
const showSideCta = !isContactPage && !isSearchPage && !isAboutPage && !isHome;
---
<!doctype html><html lang={`${LOCALE.lang ?? "en"}`} class={`${scrollSmooth && "scroll-smooth"}`}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" type="image/png" href="/1789058902899-favicon.png"/><link rel="apple-touch-icon" href="/1789058902899-favicon.png"/><link rel="canonical" href={canonicalURL}/><meta name="generator" content={Astro.generator}/><title>{title}</title><meta name="title" content={title}/><meta name="description" content={description}/><meta name="author" content={author}/><link rel="sitemap" href="/sitemap-index.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalURL}/><meta property="og:image" content={socialImageURL}/>{pubDatetime && <meta property="article:published_time" content={pubDatetime.toISOString()}/>} {modDatetime && <meta property="article:modified_time" content={modDatetime.toISOString()}/>}<meta property="twitter:card" content="summary_large_image"/><meta property="twitter:url" content={canonicalURL}/><meta property="twitter:title" content={title}/><meta property="twitter:description" content={description}/><meta property="twitter:image" content={socialImageURL}/><meta name="theme-color" content=""/>{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification}/>}<ViewTransitions/><script is:inline src="/toggle-theme.js"></script></head><body><div class="bg-blobs" aria-hidden="true"><span class="blob blob-1"></span><span class="blob blob-2"></span><span class="blob blob-3"></span></div><div class="site-wave" aria-hidden="true"><svg viewBox="0 0 1440 120" preserveAspectRatio="none"><path class="wave-back" d="M0,58 C180,8 340,104 560,55 C790,4 960,102 1180,54 C1290,30 1370,38 1440,56"/><path class="wave-front" d="M0,72 C190,28 350,114 570,70 C790,26 970,112 1190,68 C1300,48 1375,50 1440,68"/></svg></div>{showSideCta && <ContactCta side />}{!isContactPage && !isSearchPage && !isTagsPage && !isPostsPage && <ContactCta compact />}<slot /></body></html>
<style>
.site-wave{position:fixed;top:4.9rem;left:0;width:100%;height:7.5rem;z-index:0;pointer-events:none;overflow:hidden;opacity:.34}.site-wave svg{display:block;width:100%;height:100%;fill:none}.site-wave path{stroke-linecap:round;vector-effect:non-scaling-stroke}.site-wave .wave-back{stroke:#4e6351;stroke-width:1.4}.site-wave .wave-front{stroke:#b97a5a;stroke-width:1;opacity:.72}.bg-blobs{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:-1}.blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.16;will-change:transform}.blob-1{width:55vmax;height:55vmax;top:-18vmax;left:-15vmax;background:radial-gradient(circle at 35% 35%,#4e6351 0%,transparent 70%);animation:drift-1 28s ease-in-out infinite alternate}.blob-2{width:45vmax;height:45vmax;bottom:-16vmax;right:-12vmax;background:radial-gradient(circle at 60% 40%,#b97a5a 0%,transparent 70%);animation:drift-2 24s ease-in-out infinite alternate}.blob-3{width:32vmax;height:32vmax;top:42%;left:58%;background:radial-gradient(circle at 50% 50%,#8fa396 0%,transparent 70%);opacity:.12;animation:drift-3 32s ease-in-out infinite alternate}@keyframes drift-1{from{transform:translate(0,0) scale(1)}to{transform:translate(6vmax,4vmax) scale(1.08)}}@keyframes drift-2{from{transform:translate(0,0) scale(1)}to{transform:translate(-5vmax,-6vmax) scale(1.1)}}@keyframes drift-3{from{transform:translate(0,0) scale(1)}to{transform:translate(-7vmax,5vmax) scale(.92)}}@media(prefers-reduced-motion:reduce){.blob,.site-wave path{animation:none}}@media(max-width:640px){.site-wave{top:4.3rem;height:5.5rem;opacity:.27}.site-wave .wave-back{stroke-width:1.2}.site-wave .wave-front{stroke-width:.9}}
</style>
<script is:inline>
  function setupContactCta(){const strip=document.querySelector(".contact-strip");if(!strip)return;if(strip.classList.contains("docked"))return;const cards=document.querySelectorAll("[data-contact-hero]");const card=cards[0];if(!card){strip.classList.add("is-visible");return}const observer=new IntersectionObserver(([entry])=>{strip.classList.toggle("is-visible",entry.boundingClientRect.bottom<0&&!entry.isIntersecting)},{threshold:0});observer.observe(card)}
  setupContactCta();document.addEventListener("astro:after-swap",setupContactCta);
</script>