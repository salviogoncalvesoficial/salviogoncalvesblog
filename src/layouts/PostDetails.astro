---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import NewsletterBlock from "@components/NewsletterBlock.astro";
import PostEngagement from "@components/PostEngagement.astro";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import { getCollection } from "astro:content";
import { SITE } from "@config";
import { getFirstImage } from "@utils/getFirstImage";
export interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = (post.data as { toc?: boolean }).toc ?? true;
const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;
const coverImage = ogImageUrl;
const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
const allPosts = await getCollection("blog");
const otherPosts = allPosts
  .filter(({ data }) => !data.draft)
  .filter(({ slug }) => slug !== post.slug);
const byDateDesc = (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
  (b.data.pubDatetime?.getTime() ?? 0) - (a.data.pubDatetime?.getTime() ?? 0);
const related = otherPosts
  .map((entry) => ({
    entry,
    overlap: (entry.data.tags ?? []).filter((t) => (tags ?? []).includes(t))
      .length,
  }))
  .filter((item) => item.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .map((item) => item.entry);
const picked = new Set(related.map(({ slug }) => slug));
const featured = otherPosts
  .filter(({ data }) => data.featured)
  .filter(({ slug }) => !picked.has(slug))
  .sort(byDateDesc);
featured.forEach(({ slug }) => picked.add(slug));
const recent = otherPosts
  .filter(({ slug }) => !picked.has(slug))
  .sort(byDateDesc);
const highlightPosts = [...related, ...featured, ...recent].slice(0, 3);
---
<Layout {...layoutProps}>
  <Header />
  <div class="mx-auto flex w-full max-w-5xl justify-start px-4">
    <button class="focus-outline mb-2 mt-8 flex hover:opacity-75" onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()">
      <svg xmlns="http://www.w3.org/2000/svg"><path d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"></path></svg><span>Voltar</span>
    </button>
  </div>
  <main id="main-content" class="post-layout">
    <div class="post-main">
      {coverImage && <img src={coverImage} alt={title} class="post-cover" loading="eager" />}
      <h1 transition:name={slugifyStr(title)} class="post-title">{title}</h1>
      <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} size="lg" className="my-2" />
      {showToc && tocHeadings.length > 0 && <details class="toc-mobile"><summary>Neste artigo</summary><nav class="toc" aria-label="Sumário do artigo"><ul>{tocHeadings.map((h) => <li class:list={{ "toc-sub": h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></details>}
      <article id="article" role="article" class="prose mt-8"><Content /></article>
      <ul class="my-8 flex flex-wrap gap-2">{tags.map(tag => <Tag tag={slugifyStr(tag)} />)}</ul>
      <PostEngagement slug={post.slug} />
      <div class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4">
        <button id="back-to-top" class="focus-outline whitespace-nowrap py-1 hover:opacity-75"><svg xmlns="http://www.w3.org/2000/svg" class="rotate-90"><path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707 1.414 1.414L15.586 11H6v2h9.586z"></path></svg><span>Voltar ao topo</span></button>
        <ShareLinks />
      </div>
      {highlightPosts.length > 0 && <section class="related-posts"><h2>Destaques</h2><div class="related-grid">{highlightPosts.map(({ data, slug, body }) => { const imgSrc = typeof data.ogImage === "string" ? data.ogImage : data.ogImage?.src ?? getFirstImage(body ?? ""); return <a href={`/posts/${slug}/`} class="related-card"><div class="related-thumb">{imgSrc ? <img src={imgSrc} alt="" loading="lazy" /> : <span class="related-thumb-fallback" aria-hidden="true"></span>}</div><div class="related-body"><h3>{data.title}</h3><Datetime pubDatetime={data.pubDatetime} size="sm" /></div></a>; })}</div></section>}
      <NewsletterBlock />
    </div>
  </main>
  <Footer />
</Layout>
<style>
  .post-layout { @apply mx-auto w-full max-w-[50rem] grid-cols-1 px-4 pb-12; }
  .post-main { @apply min-w-0; }
  .post-title { @apply text-2xl font-semibold text-skin-accent sm:text-3xl; }
  .post-cover { @apply mb-6 w-full rounded-2xl border border-skin-line object-cover; aspect-ratio: 770 / 330; }
  .toc-mobile { @apply my-6 rounded-xl border border-skin-line bg-skin-card p-4 sm:hidden; }
  .toc-mobile summary { @apply cursor-pointer font-semibold text-skin-accent; }
  .toc ul { @apply mt-3 space-y-2; }
  .toc li a { @apply block text-sm text-skin-base hover:text-skin-accent; }
  .toc li.toc-sub a { @apply pl-4 text-xs opacity-80; }
  .post-main :global(article.prose) { max-width: 100%; }
  .post-main :global(.video-wrap) { position: relative; width: 100%; padding-bottom: 56.25%; height: 0; margin: 1.5rem 0; border-radius: 1rem; overflow: hidden; border: 1px solid rgb(var(--color-line)); }
  .post-main :global(.video-wrap iframe) { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  .post-main :global(.youtube-lazy) { position: absolute; inset: 0; display: grid; place-items: center; width: 100%; height: 100%; border: 0; background: linear-gradient(135deg, rgb(var(--color-accent) / .18), rgb(var(--color-card) / .9)); color: rgb(var(--color-base)); cursor: pointer; }
  .post-main :global(.youtube-lazy:hover) { background: linear-gradient(135deg, rgb(var(--color-accent) / .26), rgb(var(--color-card) / .95)); }
  .post-main :global(.youtube-lazy span) { display: inline-flex; align-items: center; gap: .5rem; border-radius: 999px; background: rgb(var(--color-accent)); padding: .75rem 1.1rem; color: rgb(var(--color-inverted)); font-size: .9rem; font-weight: 600; }
  .post-main :global(img) { width: 100%; border-radius: 1rem; }
  .related-posts { @apply mt-12; }
  .related-posts h2 { @apply mb-4 text-2xl font-semibold tracking-wide; }
  .related-grid { @apply grid gap-4 sm:grid-cols-3; }
  .related-card { @apply overflow-hidden rounded-2xl border border-skin-line bg-skin-card transition-shadow hover:shadow-md; }
  .related-thumb { @apply aspect-[770/330] w-full overflow-hidden bg-skin-card; }
  .related-thumb img { @apply h-full w-full object-cover; }
  .related-thumb-fallback { @apply block h-full w-full; background: linear-gradient(135deg, rgb(var(--color-accent) / 0.15), rgb(var(--color-card) / 0.5)); }
  .related-body { @apply p-4; }
  .related-body h3 { @apply text-sm font-semibold leading-snug hover:text-skin-accent; }
</style>
<script is:inline>
  function createProgressBar() { const progressContainer = document.createElement("div"); progressContainer.className = "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill"; const progressBar = document.createElement("div"); progressBar.className = "progress-bar h-1 w-0 bg-skin-accent"; progressBar.id = "myBar"; progressContainer.appendChild(progressBar); document.body.appendChild(progressContainer); }
  createProgressBar();
  function updateScrollProgress() { const winScroll = document.body.scrollTop || document.documentElement.scrollTop; const height = document.documentElement.scrollHeight - document.documentElement.clientHeight; const scrolled = (winScroll / height) * 100; if (document) { const myBar = document.getElementById("myBar"); if (myBar) myBar.style.width = scrolled + "%"; } }
  document.addEventListener("scroll", updateScrollProgress);
  function addHeadingLinks() { let headings = Array.from(document.querySelectorAll("h2, h3, h4, h5, h6")); for (let heading of headings) { heading.classList.add("group"); let link = document.createElement("a"); link.innerText = "#"; link.className = "heading-link hidden group-hover:inline-block ml-2"; link.href = "#" + heading.id; link.ariaHidden = "true"; heading.appendChild(link); } }
  addHeadingLinks();
  function dedupeTitle() { const article = document.getElementById("article"); const postTitle = document.querySelector(".post-title"); if (!article || !postTitle) return; const norm = (s) => s.replace(/\s+/g, " ").trim().replace(/[.,!:;*]/g, "").toLowerCase(); const firstH1 = article.querySelector("h1"); if (firstH1 && norm(firstH1.textContent) === norm(postTitle.textContent)) firstH1.remove(); }
  dedupeTitle(); document.addEventListener("astro:after-swap", dedupeTitle);
  function attachLazyYouTube() {
    document.querySelectorAll(".video-wrap iframe").forEach((oldFrame) => {
      if (oldFrame.dataset.lazyYoutube === "1") return;
      const source = oldFrame.getAttribute("src") || "";
      const match = source.match(/(?:youtube\.com\/embed\/|youtu\.be\/)([A-Za-z0-9_-]{6,})/);
      if (!match) return;
      const id = match[1];
      const placeholder = document.createElement("button");
      placeholder.type = "button";
      placeholder.className = "youtube-lazy";
      placeholder.setAttribute("aria-label", "Carregar vídeo do YouTube");
      placeholder.innerHTML = "<span>▶ Carregar vídeo</span>";
      placeholder.addEventListener("click", () => {
        const frame = document.createElement("iframe");
        frame.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
        frame.title = oldFrame.getAttribute("title") || "Vídeo do YouTube";
        frame.setAttribute("frameborder", "0");
        frame.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share");
        frame.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
        frame.setAttribute("allowfullscreen", "");
        placeholder.replaceWith(frame);
      }, { once: true });
      oldFrame.dataset.lazyYoutube = "1";
      oldFrame.replaceWith(placeholder);
    });
  }
  attachLazyYouTube(); document.addEventListener("astro:after-swap", attachLazyYouTube);
  function attachCopyButtons() { let copyButtonLabel = "Copy"; let codeBlocks = Array.from(document.querySelectorAll("pre")); for (let codeBlock of codeBlocks) { let wrapper = document.createElement("div"); wrapper.style.position = "relative"; let copyButton = document.createElement("button"); copyButton.className = "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium"; copyButton.innerHTML = copyButtonLabel; codeBlock.setAttribute("tabindex", "0"); codeBlock.appendChild(copyButton); codeBlock?.parentNode?.insertBefore(wrapper, codeBlock); wrapper.appendChild(codeBlock); copyButton.addEventListener("click", async () => { await copyCode(codeBlock, copyButton); }); } async function copyCode(block, button) { let code = block.querySelector("code"); let text = code?.innerText; await navigator.clipboard.writeText(text ?? ""); button.innerText = "Copied"; setTimeout(() => { button.innerText = copyButtonLabel; }, 700); } }
  attachCopyButtons();
  function backToTop() { document.querySelector("#back-to-top")?.addEventListener("click", () => { document.body.scrollTop = 0; document.documentElement.scrollTop = 0; }); }
  backToTop();
</script>